<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <org.webrtc.SurfaceViewRenderer
        android:id="@+id/tileVideo"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="invisible" />

    <TextView
        android:id="@+id/tileNumber"
        style="@style/Chip"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|start"
        android:layout_margin="5dp"
        android:paddingStart="6dp"
        android:paddingTop="1dp"
        android:paddingEnd="6dp"
        android:paddingBottom="1dp"
        android:text="1"
        android:textColor="@color/text_primary"
        android:textSize="10sp"
        android:background="@drawable/bg_chip" />

    <TextView
        android:id="@+id/tileBadge"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|end"
        android:layout_margin="6dp"
        android:background="@drawable/bg_chip_accent"
        android:text="A"
        android:textColor="#FF111318"
        android:textSize="11sp"
        android:fontFamily="sans-serif-medium"
        android:paddingStart="7dp"
        android:paddingEnd="7dp"
        android:paddingTop="3dp"
        android:paddingBottom="3dp"
        android:visibility="gone" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:background="@drawable/bg_tile_scrim"
        android:orientation="vertical"
        android:paddingStart="8dp"
        android:paddingEnd="30dp"
        android:paddingTop="8dp"
        android:paddingBottom="4dp">

        <TextView
            android:id="@+id/tileName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:fontFamily="sans-serif-medium"
            android:maxLines="1"
            android:text="Cámara 1"
            android:textColor="@color/text_primary"
            android:textSize="10sp" />

        <TextView
            android:id="@+id/tileStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="Sin conectar"
            android:textColor="@color/text_secondary"
            android:textSize="9sp" />
    </LinearLayout>

    <TextView
        android:id="@+id/tileHint"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|end"
        android:layout_margin="5dp"
        android:gravity="center"
        android:includeFontPadding="false"
        android:text="+"
        android:textColor="@color/stroke"
        android:textSize="16sp" />

</merge>
