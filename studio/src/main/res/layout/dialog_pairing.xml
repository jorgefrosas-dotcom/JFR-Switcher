<?xml version="1.0" encoding="utf-8"?>
<!-- Ventana de emparejamiento.
     Compacta a propósito (pedido de Jorge, 29/10): la IP salía cortada y el QR no entraba.
     El QR manda: va en una columna propia y es lo más grande. La ventana se ajusta al contenido
     (sin 62 % fijo) y el botón «Listo» ya no ocupa todo el ancho. -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:padding="14dp"
    android:scrollbars="none">

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            style="@style/Txt.Title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Conectar cámaras"
            android:textSize="15sp" />

        <TextView
            android:id="@+id/txtSteps"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="Misma red WiFi. Abre JFR Camera, toca «QR» y apunta al código."
            android:textColor="@color/text_dim"
            android:textSize="10sp" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:orientation="horizontal">

            <!-- El QR primero y con su propio espacio: es lo que más se usa. -->
            <LinearLayout
                android:layout_width="148dp"
                android:layout_height="wrap_content"
                android:gravity="center_horizontal"
                android:orientation="vertical">

                <TextView
                    style="@style/Txt.Micro"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="ESCANEA ESTE CÓDIGO"
                    android:textSize="9sp" />

                <ImageView
                    android:id="@+id/imgQr"
                    android:layout_width="148dp"
                    android:layout_height="148dp"
                    android:layout_marginTop="4dp"
                    android:background="@android:color/white"
                    android:contentDescription="Código QR con la dirección de este equipo"
                    android:padding="7dp"
                    android:scaleType="fitCenter" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="14dp">

                <TextView
                    style="@style/Txt.Micro"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="O ESCRIBE ESTA IP"
                    android:textSize="9sp" />

                <TextView
                    android:id="@+id/txtIp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:fontFamily="monospace"
                    android:maxLines="1"
                    android:text="192.168.1.0"
                    android:textColor="@color/accent"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/txtPort"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="Puerto 8787"
                    android:textColor="@color/text_dim"
                    android:textSize="10sp" />

                <TextView
                    android:id="@+id/btnCopyIp"
                    style="@style/PillButton.Ghost"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:paddingTop="5dp"
                    android:paddingBottom="5dp"
                    android:text="Copiar IP"
                    android:textSize="10sp" />

                <TextView
                    android:id="@+id/txtConnCount"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:text="Conectadas: 0 / 6"
                    android:textColor="@color/text_primary"
                    android:textSize="10sp" />
            </LinearLayout>
        </LinearLayout>

        <TextView
            android:id="@+id/btnClose"
            style="@style/PillButton.Accent"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="12dp"
            android:minWidth="140dp"
            android:text="Listo"
            android:textSize="12sp" />
    </LinearLayout>
</ScrollView>
