<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android">

    <ImageView
        android:id="@+id/overlayThumb"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/bg_tile"
        android:contentDescription="Miniatura del overlay"
        android:padding="6dp"
        android:scaleType="fitCenter" />

    <TextView
        android:id="@+id/overlayName"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:visibility="gone" />

    <TextView
        android:id="@+id/overlayBadge"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|start"
        android:layout_margin="5dp"
        android:background="@drawable/bg_chip_accent"
        android:paddingStart="6dp"
        android:paddingTop="2dp"
        android:paddingEnd="6dp"
        android:paddingBottom="2dp"
        android:text="A"
        android:textColor="#FF111318"
        android:textSize="10sp"
        android:textStyle="bold"
        android:visibility="gone" />

    <TextView
        android:id="@+id/overlayOff"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:background="@drawable/bg_chip"
        android:paddingStart="8dp"
        android:paddingTop="3dp"
        android:paddingEnd="8dp"
        android:paddingBottom="3dp"
        android:text="Oculto"
        android:textColor="@color/text_secondary"
        android:textSize="10sp"
        android:visibility="gone" />

    <TextView
        android:id="@+id/overlayDelete"
        android:layout_width="26dp"
        android:layout_height="26dp"
        android:layout_gravity="top|end"
        android:layout_margin="5dp"
        android:background="@drawable/bg_delete"
        android:gravity="center"
        android:text="×"
        android:textColor="@color/text_primary"
        android:textSize="15sp"
        android:textStyle="bold" />

</merge>
