<?xml version="1.0" encoding="utf-8"?>
<!-- Perilla del deslizador de ajustes de imagen (círculo, cómoda de tocar). -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="oval">
            <solid android:color="#FFFFFF" />
            <stroke android:width="3dp" android:color="#3DDC84" />
            <size
                android:width="20dp"
                android:height="20dp" />
        </shape>
    </item>
</layer-list>
