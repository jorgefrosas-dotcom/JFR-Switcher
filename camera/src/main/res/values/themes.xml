<resources xmlns:tools="http://schemas.android.com/tools">

    <style name="Theme.JfrSwitcher" parent="Theme.Material3.Dark.NoActionBar">
        <item name="colorPrimary">@color/accent</item>
        <item name="colorOnPrimary">#FF111318</item>
        <item name="colorSecondary">@color/live_green</item>
        <item name="colorSurface">@color/bg_panel</item>
        <item name="android:windowBackground">@color/bg_root</item>
        <item name="android:statusBarColor">@color/bg_root</item>
        <item name="android:navigationBarColor">@color/bg_root</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>
    </style>

    <!-- Botón de la barra inferior: plano, compacto y con icono a la izquierda. -->
    <style name="Widget.JfrCam.Boton" parent="Widget.Material3.Button">
        <item name="android:minWidth">0dp</item>
        <item name="android:minHeight">0dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:elevation">0dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">14sp</item>
        <item name="android:letterSpacing">0</item>
        <item name="android:textColor">@color/texto_principal</item>
        <item name="backgroundTint">@color/bg_panel_2</item>
        <item name="cornerRadius">14dp</item>
        <item name="iconTint">@color/texto_principal</item>
        <item name="iconPadding">8dp</item>
        <item name="iconSize">20dp</item>
    </style>

    <!-- Variante acentuada para la acción principal (Conectar). -->
    <style name="Widget.JfrCam.Boton.Primario">
        <item name="android:textColor">@color/on_accent</item>
        <item name="backgroundTint">@color/accent</item>
        <item name="iconTint">@color/on_accent</item>
    </style>

    <!-- Botón flotante sobre el video: chico y translúcido para no tapar la imagen. -->
    <style name="Widget.JfrCam.BotonMini" parent="Widget.JfrCam.Boton">
        <item name="android:textSize">11sp</item>
        <item name="android:paddingStart">10dp</item>
        <item name="android:paddingEnd">10dp</item>
        <item name="android:paddingTop">0dp</item>
        <item name="android:paddingBottom">0dp</item>
        <item name="cornerRadius">18dp</item>
        <item name="backgroundTint">#CC1B1F26</item>
        <item name="iconSize">16dp</item>
        <item name="iconPadding">5dp</item>
    </style>

    <style name="Widget.JfrCam.BotonMini.Primario" parent="Widget.JfrCam.BotonMini">
        <item name="android:textColor">@color/on_accent</item>
        <item name="backgroundTint">@color/accent</item>
        <item name="iconTint">@color/on_accent</item>
    </style>

</resources>
