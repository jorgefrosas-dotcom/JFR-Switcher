<?xml version="1.0" encoding="utf-8"?>
<!--
  Pantalla única de JFR Camera (celular, horizontal).

  El video ocupa TODA la pantalla (escala FIT: se ve el cuadro completo, sin recortes)
  y los controles son pastillas flotantes y translúcidas encima de la imagen, para que
  quien opera la cámara tenga el mayor campo visual posible.
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_root">

    <org.webrtc.SurfaceViewRenderer
        android:id="@+id/preview"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- Barra superior flotante: marca, IP, conectar y estado. -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|start"
        android:layout_margin="8dp"
        android:background="@drawable/bg_glass"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="12dp"
        android:paddingTop="5dp"
        android:paddingEnd="6dp"
        android:paddingBottom="5dp">

        <TextView
            android:id="@+id/txtMarca"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="10dp"
            android:fontFamily="sans-serif-medium"
            android:text="@string/app_name"
            android:textColor="@color/accent"
            android:textSize="12sp" />

        <EditText
            android:id="@+id/campoIp"
            android:layout_width="132dp"
            android:layout_height="32dp"
            android:background="@drawable/bg_glass_campo"
            android:hint="@string/hint_ip"
            android:imeOptions="actionGo"
            android:importantForAutofill="no"
            android:inputType="text"
            android:digits="0123456789.:"
            android:maxLength="64"
            android:maxLines="1"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            android:singleLine="true"
            android:textColor="@color/texto_principal"
            android:textColorHint="@color/texto_tenue"
            android:textSize="13sp"
            tools:ignore="LabelFor" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnQr"
            style="@style/Widget.JfrCam.BotonMini"
            android:layout_width="wrap_content"
            android:layout_height="32dp"
            android:layout_marginStart="6dp"
            android:text="@string/qr"
            android:contentDescription="Escanear el QR de la tablet"
            app:icon="@android:drawable/ic_menu_camera"
            app:iconGravity="textStart"
            app:iconPadding="4dp"
            app:iconSize="16dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnConectar"
            style="@style/Widget.JfrCam.BotonMini.Primario"
            android:layout_width="wrap_content"
            android:layout_height="32dp"
            android:layout_marginStart="6dp"
            android:text="@string/conectar" />

        <TextView
            android:id="@+id/chipEstado"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:layout_marginEnd="6dp"
            android:background="@drawable/bg_chip"
            android:ellipsize="end"
            android:maxWidth="190dp"
            android:maxLines="1"
            android:paddingHorizontal="9dp"
            android:paddingVertical="4dp"
            android:text="@string/estado_sin_conectar"
            android:textColor="@color/on_chip"
            android:textSize="11sp"
            android:textStyle="bold"
            tools:text="Cámara 3" />
    </LinearLayout>

    <!-- Controles flotantes abajo a la derecha. -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|end"
        android:layout_margin="8dp"
        android:background="@drawable/bg_glass"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="5dp">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnVoltear"
            style="@style/Widget.JfrCam.BotonMini"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:contentDescription="@string/voltear_desc"
            android:enabled="false"
            android:minWidth="44dp"
            android:text="@string/voltear"
            app:icon="@drawable/ic_voltear" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnLinterna"
            style="@style/Widget.JfrCam.BotonMini"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:layout_marginStart="5dp"
            android:enabled="false"
            android:minWidth="44dp"
            android:text="@string/linterna"
            app:icon="@drawable/ic_linterna" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnCalidad"
            style="@style/Widget.JfrCam.BotonMini"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:layout_marginStart="5dp"
            android:text="@string/calidad"
            app:icon="@drawable/ic_calidad" />

        <LinearLayout
            android:id="@+id/panelVivo"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:layout_marginEnd="6dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <View
                android:id="@+id/puntoVivo"
                android:layout_width="9dp"
                android:layout_height="9dp"
                android:background="@drawable/bg_punto" />

            <TextView
                android:id="@+id/txtVivo"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:text="@string/sin_senal"
                android:textColor="@color/texto_tenue"
                android:textSize="11sp"
                android:textStyle="bold"
                tools:text="En vivo" />
        </LinearLayout>

        <TextView
            android:id="@+id/chipAlAire"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:background="@drawable/bg_chip"
            android:paddingStart="9dp"
            android:paddingTop="5dp"
            android:paddingEnd="9dp"
            android:paddingBottom="5dp"
            android:text="FUERA DE AIRE"
            android:textColor="@color/texto_tenue"
            android:textSize="10sp"
            android:textStyle="bold"
            tools:text="AL AIRE" />
    </LinearLayout>

    <!-- Instrucciones cuando todavía no hay enlace (tarjeta compacta, no tapa todo). -->
    <LinearLayout
        android:id="@+id/overlayInstrucciones"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:background="@drawable/bg_glass"
        android:gravity="center"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingTop="14dp"
        android:paddingEnd="20dp"
        android:paddingBottom="14dp">

        <TextView
            android:id="@+id/txtInstrucciones"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:lineSpacingExtra="4dp"
            android:text="@string/instrucciones"
            android:textColor="@color/texto_principal"
            android:textSize="13sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center"
            android:text="@string/nota_audio"
            android:textColor="@color/texto_tenue"
            android:textSize="11sp" />
    </LinearLayout>

</FrameLayout>
